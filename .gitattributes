# Shell scripts must keep LF, or bash fails on Windows checkouts with core.autocrlf=true.
*.sh text eol=lf
*.command text eol=lf

# TUM snapshot stays byte-identical to notes/tum_upstream_manifest.json on every platform.
race-simulation/** -text

# Fitted race files: keep LF so the hashes in their manifests stay valid on every machine.
integration/parameters/*.ini text eol=lf
